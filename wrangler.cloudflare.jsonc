{
  "name": "coles-cold-drinks-stock-planner",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
